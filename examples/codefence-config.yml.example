# Codefence repository config (schema version 1).
# Copy to the repo root as codefence-config.yml and adjust.
# Precedence: CLI flags > CODEFENCE_* env > this file > builtins.

version: 1

scan:
  aspects: [code]
  format: table # table | json
  quiet: false
  verbose: false

paths:
  git_ignored_prefixes: []
  # Example:
  # git_ignored_prefixes:
  #   - examples/

deps:
  provider: osv # osv | custom
  provider_url: null
  refresh: false
  cache_ttl: 24h
  timeout: 15s
  http2: auto # auto | on | off
  scope: changed # changed | tree

secret:
  rules: []
  default_rules: on # on | off
  default_rules_version: null
  rules_update_url: null
  rules_refresh: false
  rules_cache_ttl: 24h
  entropy_threshold: 4.2
  min_length: 12
  min_confidence: low # low | medium | high
